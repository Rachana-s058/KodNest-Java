import java.util.Scanner;

public class RotateArrayLeftByK {
    public static void main(String[] args) {
        Scanner scan = new Scanner(System.in);

        int n = scan.nextInt();

        int[] arr = new int[n];
        for(int i=0; i<n; i++){
            arr[i] = scan.nextInt();
        }

        long kInput = scan.nextLong();

        int k = 0;
        if(n>0){
            k = (int) (kInput%n);
        }
        reverse(arr, 0, k-1);

        reverse(arr, k, n-1);

        reverse(arr, 0, n-1);

        for(int i=0; i<n; i++){
            System.out.print(arr[i]);
            if(i<n-1){
                System.out.print(" ");
            }
        }
        System.out.println();
        scan.close();
    }
    private static void reverse(int[] arr, int start, int end){
        while(start<end){
            int temp = arr[start];
            arr[start] = arr[end];
            arr[end] = temp;
            start++;
            end--;
        }
    }
}